# Optional override (gitignored as inference.env). Default Argo-synced secret already
# points at the in-cluster OpenShift AI model:
#   http://aiops-llm-predictor.aiops-inference.svc.cluster.local:8000/v1
#
# Use this file only to switch to a remote endpoint (NIM / OpenAI / etc.):
#   cp inference.env.example inference.env
#   # edit values
#   ./aiops-sandboxed-agent-fleet/scripts/apply-inference-secret.sh

NEMOCLAW_INFERENCE_PROVIDER=openai
NEMOCLAW_INFERENCE_BASE_URL=http://aiops-llm-predictor.aiops-inference.svc.cluster.local:8000/v1
NEMOCLAW_MODEL=aiops-llm
NEMOCLAW_API_KEY=unused
OPENCLAW_GATEWAY_PASSWORD=openclaw
MONITORING_GRAFANA_PASSWORD=openclaw

# Optional — raises ghcr.io pull limits for openclaw-sandbox
GHCR_USER=
GHCR_TOKEN=
